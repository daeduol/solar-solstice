---
import { languages } from '@i18n/ui';
import { Icon } from 'astro-icon';

interface Props {
	size?: 'sm' | 'md' | 'lg';
	block?: boolean;
	style?: 'primary';
	class?: string;
	[x: string]: any;
}

const { size = 'md', style = 'primary', block, class: dropbtn, ...rest } = Astro.props;

const sizes = {
	sm: 'px-1 py-1',
	md: 'px-1 py-1',
	lg: 'px-1 py-1',
};

const styles = {
	primary: 'bg-black text-white hover:bg-orange  border-2 border-transparent',
};
---
<div class="dropdown">
	<button
		{...rest}
		class:list={[
			'rounded-xl text-center ring-orange ring-offset-2 transition focus-visible:ring-2',
			block && 'w-full',
			sizes[size],
			styles[style],
			dropbtn,
		]}
		><slot />
		<Icon class="flex h-8 md:h-8" name="clarity:language-line" />
	</button>
	<div class="dropdown-content">
		{
			Object.entries(languages).map(([lang, label]) => (
				<a
					href={lang === 'en' ? `/` : `/${lang}/`}
					onclick={`window.location.href = '${lang === 'en' ? '/' : `/${lang}/`}'`}
				>
					{label}
				</a>
			))
		}
	</div>
</div>

<style>
	/* Agrega estilos para la apariencia del botón y del desplegable */

	.dropdown {
		position: relative;
		display: inline-block;
	}

	.dropbtn {
		background-color: #e06330;
		color: white;
		padding: 10px;
		font-size: 16px;
		border: none;
		cursor: pointer;
	}

	.dropdown-content {
		display: none;
		position: absolute;
		background-color: #f9f9f9;
		min-width: 12px;

		box-shadow: 0px 8px 16px 0px rgba(0, 0, 0, 0.2);
		z-index: 1;
	}

	.dropdown-content a {
		color: black;
		padding: 10px 12px;
		text-decoration: none;
		display: block;
	}

	.dropdown-content a:hover {
		background-color: #e06330;
	}

	.dropdown:hover .dropdown-content {
		display: block;
	}

	.dropdown:hover .dropbtn {
		background-color: #e06330;
	}
</style>
